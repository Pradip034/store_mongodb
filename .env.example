PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
ADMIN_EMAIL=admin@example.com
# Run node setup.mjs to create a random password; never use a public default.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# International number, digits only, e.g. country code 91 followed by your number.
WHATSAPP_NUMBER=
# Razorpay test keys first. Empty keys disable online payment, not the catalogue.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Delivery charge in paise. Set 0 for free delivery.
DELIVERY_FEE=4000
FREE_DELIVERY_ABOVE=49900
# Keep true until you have replaced sample products, prices and photos.
DEMO_CATALOG=true

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=health_partner
SEED_DEMO=true
